<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Keep the standard AndroidJUnitRunner generated by Gradle for the existing recovery/device
        suites, and register a second lightweight runner only for F11 semantic-contract checks.
        The F11 workflow separately proves the real LifeOsApplication cold start before invoking it.
    -->
    <instrumentation
        android:name="app.lifeos.next.LifeOsTestRunner"
        android:targetPackage="app.lifeos.next"
        android:functionalTest="false"
        android:handleProfiling="false" />
</manifest>
